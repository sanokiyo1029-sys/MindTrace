# Copy to .env and fill in. Never commit .env.

# AI
# No key is needed. Gemini opens in the teacher's own Google account; Lens reads scans. Optional server key below
# switches on AI question drafts and AI paper reading (otherwise labelled samples + the bubble reader).
GEMINI_API_KEY=              # from https://aistudio.google.com/apikey (server only, never VITE_). LLM_API_KEY also works.
# AI_MODE=fixtures           # optional: force the offline labelled samples even when a key is set
LLM_MODEL=                   # optional, default gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=           # optional, AI assistant model (must accept images); default LLM_VISION_MODEL / LLM_MODEL

# Backend
# DATABASE_URL defaults to backend/mindtrace.db
SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173
SESSION_HOURS=168         # sign-in sessions end after this many hours

# Scanner tuning (see backend/README.md)
OMR_FILLED=0.42
OMR_EMPTY=0.18

# Frontend (Vite reads VITE_*)
VITE_API_URL=/api
VITE_MOCK=false

# Google sign-in (optional). OAuth "Web application" client ID from Google Cloud Console; put it FIRST.
# The website and the Android app both use it (the app's ID tokens are issued for the web client ID).
# Comma-separate several. Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
# Google accounts (comma-separated emails) allowed to sign in as the demo teacher.
GOOGLE_TEACHER_EMAILS=
