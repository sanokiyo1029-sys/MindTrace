# Copy to .env and fill in. Never commit .env.

# AI
AI_MODE=fixtures            # fixtures | live  (live + LLM_PROVIDER=gemini + LLM_API_KEY turns Gemini on)
LLM_PROVIDER=gemini         # gemini | openai | anthropic
LLM_MODEL=                   # optional, default gemini-3.5-flash-lite
LLM_API_KEY=                 # Gemini key from https://aistudio.google.com/apikey (server only, never VITE_)
GEMINI_CHAT_MODEL=           # optional, AI assistant model (must accept images); default LLM_VISION_MODEL / LLM_MODEL

# Backend
# DATABASE_URL defaults to backend/mindtrace.db
SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173
SESSION_HOURS=168         # sign-in sessions end after this many hours

# Scanner tuning (see backend/README.md)
OMR_FILLED=0.42
OMR_EMPTY=0.18

# Frontend (Vite reads VITE_*)
VITE_API_URL=/api
VITE_MOCK=false

# Google sign-in (optional). OAuth "Web application" client ID from Google Cloud Console; put it FIRST.
# The website and the Android app both use it (the app's ID tokens are issued for the web client ID).
# Comma-separate several. Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
# Google accounts (comma-separated emails) allowed to sign in as the demo teacher.
GOOGLE_TEACHER_EMAILS=
# Google account subject IDs of teachers whose subscription the admin verified.
# Leave empty to hide the Gemini assistant for everyone. Remove expired subscriptions.
GEMINI_APPROVED_GOOGLE_SUBS=
# Server-only key restricted to Cloud Vision API and Cloud Translation API.
# Leave empty to disable cloud text recognition/translation in scan review.
GOOGLE_SCAN_API_KEY=
