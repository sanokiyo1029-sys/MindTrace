# Copy to .env and fill in. Never commit .env.

# AI
AI_MODE=fixtures            # fixtures | live  (live + LLM_PROVIDER=gemini + LLM_API_KEY turns Gemini on)
LLM_PROVIDER=gemini         # gemini | openai | anthropic
LLM_MODEL=                   # optional, default gemini-3.5-flash-lite
LLM_API_KEY=                 # Gemini key from https://aistudio.google.com/apikey (server only, never VITE_)

# Backend
# DATABASE_URL defaults to backend/mindtrace.db
SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173
SESSION_HOURS=168         # sign-in sessions end after this many hours

# Scanner tuning (see backend/README.md)
OMR_FILLED=0.42
OMR_EMPTY=0.18

# Frontend (Vite reads VITE_*)
VITE_API_URL=/api
VITE_MOCK=false

# Google sign-in (optional). OAuth "Web application" client ID from Google Cloud Console.
# Comma-separate several (e.g. web + Android later). Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
# Google accounts (comma-separated emails) allowed to sign in as the demo teacher.
GOOGLE_TEACHER_EMAILS=
