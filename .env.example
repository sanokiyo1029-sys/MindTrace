# Copy to .env and fill in. Never commit .env.

# AI
AI_MODE=fixtures            # fixtures | live
LLM_PROVIDER=gemini         # gemini | openai | anthropic
LLM_MODEL=
LLM_API_KEY=

# Backend
# DATABASE_URL defaults to backend/mindtrace.db
SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173

# Scanner tuning (see backend/README.md)
OMR_FILLED=0.42
OMR_EMPTY=0.18

# Frontend (Vite reads VITE_*)
VITE_API_URL=/api
VITE_MOCK=true
