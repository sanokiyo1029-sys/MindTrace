{
  "id": "as_001",
  "class_id": "cl_7a",
  "title": "Fractions check 1",
  "topic": "fractions",
  "concepts_text": "Add fractions with equal and unequal denominators. Compare fractions using common denominators.",
  "questions": [
    {
      "topic": "fractions",
      "concept": "adding fractions with equal denominators",
      "stem": "What is 1/3 + 1/3?",
      "options": {
        "A": "2/6",
        "B": "2/3",
        "C": "1/9",
        "D": "1/3"
      },
      "answer": "B",
      "explanation": "Same denominator: add the numerators, keep the denominator. 1/3 + 1/3 = 2/3.",
      "distractors": {
        "A": {
          "misconception_id": "M_ADD_DENOMS",
          "why": "Added top and bottom numbers"
        },
        "C": {
          "misconception_id": "M_MULTIPLY_INSTEAD",
          "why": "Multiplied the fractions"
        },
        "D": {
          "misconception_id": "M_IGNORE_SECOND",
          "why": "Ignored the second fraction"
        }
      },
      "difficulty": "easy",
      "source": "sample",
      "id": "q_001",
      "assessment_id": "as_001",
      "status": "approved"
    },
    {
      "topic": "fractions",
      "concept": "adding fractions with unequal denominators (LCM)",
      "stem": "What is 1/2 + 1/3?",
      "options": {
        "A": "2/5",
        "B": "5/6",
        "C": "2/6",
        "D": "1/6"
      },
      "answer": "B",
      "explanation": "Make sixths: 1/2 = 3/6 and 1/3 = 2/6, so 3/6 + 2/6 = 5/6.",
      "distractors": {
        "A": {
          "misconception_id": "M_NO_COMMON_DENOM",
          "why": "Added tops and bottoms without a common denominator"
        },
        "C": {
          "misconception_id": "M_LCM_ERROR",
          "why": "Used 6 as the denominator but did not scale the numerators"
        },
        "D": {
          "misconception_id": "M_MULTIPLY_INSTEAD",
          "why": "Multiplied the fractions"
        }
      },
      "difficulty": "medium",
      "source": "sample",
      "id": "q_002",
      "assessment_id": "as_001",
      "status": "approved"
    },
    {
      "topic": "fractions",
      "concept": "comparing fractions",
      "stem": "Which is greater: 3/5 or 5/7?",
      "options": {
        "A": "3/5",
        "B": "5/7",
        "C": "They are equal",
        "D": "Can't compare: different denominators"
      },
      "answer": "B",
      "explanation": "Use 35ths: 3/5 = 21/35 and 5/7 = 25/35, so 5/7 is greater.",
      "distractors": {
        "A": {
          "misconception_id": "M_SMALLER_DENOM_BIGGER",
          "why": "Looked only at the denominators"
        },
        "C": {
          "misconception_id": "M_GAP_THINKING",
          "why": "Both are missing two pieces, so thought they are equal"
        },
        "D": {
          "misconception_id": "M_CANT_COMPARE_UNLIKE",
          "why": "Thought unlike fractions can't be compared"
        }
      },
      "difficulty": "medium",
      "source": "sample",
      "id": "q_003",
      "assessment_id": "as_001",
      "status": "approved"
    }
  ],
